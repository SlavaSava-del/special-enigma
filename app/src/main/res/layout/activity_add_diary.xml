<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/backTitle"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/blue_main"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:text="←   Метео-дневник"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Как вы себя чувствуете?"
                    android:textColor="#222222"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Общее состояние"
                    android:textColor="#777777"
                    android:textSize="17sp" />

                <Spinner
                    android:id="@+id/healthSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Симптом"
                    android:textColor="#777777"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/symptomsText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Выберите симптомы"
                    android:textColor="#222222"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Комментарий"
                    android:textColor="#777777"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/commentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top|start"
                    android:hint="Например: головная боль усилилась к вечеру"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="250"
                    android:padding="12dp"
                    android:singleLine="false"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:textSize="18sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/saveDiaryButton"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="Сохранить"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>