<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/blue_main"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:text="Профиль"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Имя"
                    android:textColor="#666666"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/nameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input"
                    android:inputType="textPersonName"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Город"
                    android:textColor="#666666"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/cityEditText"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input"
                    android:inputType="text"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Тип метеочувствительности"
                    android:textColor="#666666"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/sensitivitySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input" />

                <Switch
                    android:id="@+id/warningsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:text="Предупреждения"
                    android:textSize="19sp" />

                <Switch
                    android:id="@+id/autoUpdateSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Обновлять погоду автоматически"
                    android:textSize="19sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/statisticsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Статистика"
                    android:textColor="#222222"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statisticPreviewText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Анализ записей дневника поможет определить возможные погодные триггеры."
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/openStatisticsButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_light_button"
                    android:gravity="center"
                    android:text="Открыть статистику"
                    android:textColor="@color/blue_main"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/saveProfileButton"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="Сохранить"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_home"
            android:drawablePadding="4dp"
            android:drawableTint="#666666"
            android:gravity="center"
            android:text="Главная"
            android:textColor="#666666"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navDiary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_diary"
            android:drawablePadding="4dp"
            android:drawableTint="#666666"
            android:gravity="center"
            android:text="Дневник"
            android:textColor="#666666"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_profile"
            android:drawablePadding="4dp"
            android:drawableTint="@color/blue_main"
            android:gravity="center"
            android:text="Профиль"
            android:textColor="@color/blue_main"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>