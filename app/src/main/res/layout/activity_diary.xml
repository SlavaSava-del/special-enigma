<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/blue_main"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="←   Метео-дневник"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/entriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_home"
                android:drawablePadding="4dp"
                android:drawableTint="#666666"
                android:gravity="center"
                android:text="Главная"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/navDiary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_diary"
                android:drawablePadding="4dp"
                android:drawableTint="@color/blue_main"
                android:gravity="center"
                android:text="Дневник"
                android:textColor="@color/blue_main"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_profile"
                android:drawablePadding="4dp"
                android:drawableTint="#666666"
                android:gravity="center"
                android:text="Профиль"
                android:textColor="#666666"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/addDiaryButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_button"
        android:elevation="8dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="40sp" />

</FrameLayout>